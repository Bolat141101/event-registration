# Local development only. Change all secrets before exposing the application.
# POSTGRES_USER is the bootstrap administrator; API containers never use it.
POSTGRES_DB=event_registration
POSTGRES_USER=events
POSTGRES_PASSWORD=local_events_password_change_me
ORGANIZER_TOKEN=local_organizer_token_change_me_32_chars_minimum
POSTGRES_PORT=5433
FRONTEND_PORT=8080
MAILPIT_PORT=8025
CORE_DB_USER=core_app
CORE_DB_PASSWORD=local_core_password_change_me
NOTIFICATIONS_DB=event_notifications
NOTIFICATIONS_DB_USER=notifications_app
NOTIFICATIONS_DB_PASSWORD=local_notifications_password_change_me
